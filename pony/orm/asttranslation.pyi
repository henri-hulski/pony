from ast import (
    AST,
    Attribute,
    BinOp,
    BoolOp,
    Call,
    Compare,
    Constant,
    Dict,
    Eq,
    FormattedValue,
    GeneratorExp,
    Gt,
    IfExp,
    In,
    JoinedStr,
    Lambda,
    List,
    Lt,
    Name,
    NotEq,
    Slice,
    Starred,
    Subscript,
    Tuple,
    UnaryOp,
    comprehension,
    expr,
    keyword,
)
from collections.abc import Callable, Iterable, Iterator, Sequence
from typing import Any, TypeVar

from pony.orm.core import CodeKey, ConstType

_ExprT = TypeVar("_ExprT", bound=expr)

class TranslationError(Exception): ...

def ast2src(tree: AST) -> str: ...
def binop_src(op: str, node: BinOp) -> str: ...
def create_extractors(
    code_key: CodeKey,
    tree: _ExprT,
    globals: dict[str, object],
    locals: dict[str, object],
    special_functions: set[Callable],
    const_functions: set[ConstType],
    outer_names: Sequence[str] = (),
) -> tuple[_ExprT, dict[str, Callable]]: ...
def get_child_nodes(node: AST) -> Iterator[AST]: ...
def priority(p: int) -> Callable: ...

class ASTTranslator:
    tree: GeneratorExp

    def __init__(self, tree: GeneratorExp) -> None: ...
    def call(self, method: Callable, node: AST) -> Any: ...
    def default_post(self, node: AST) -> None: ...
    def default_pre(self, node: AST) -> bool | None: ...
    def dispatch(self, node: expr) -> None: ...

class PythonTranslator(ASTTranslator):
    top_level_f_str: str | None

    def __init__(self, tree: AST) -> None: ...
    def call(self, method: Callable, node: AST) -> None: ...
    def default_pre(self, node: AST) -> bool | None: ...
    def postAdd(self, node: BinOp) -> str: ...
    def postAnd(self, node: BoolOp) -> str: ...
    def postAttribute(self, node: Attribute) -> str: ...
    def postBitAnd(self, node: BinOp) -> str: ...
    def postCall(self, node: Call) -> str: ...
    def postCompare(self, node: Compare) -> str: ...
    def postConstant(self, node: Constant) -> str: ...
    def postDict(self, node: Dict) -> str: ...
    def postDiv(self, node: BinOp) -> str: ...
    def postEq(self, node: Eq) -> str: ...
    def postFloorDiv(self, node: BinOp) -> str: ...
    def postFormattedValue(self, node: FormattedValue) -> str: ...
    def postGeneratorExp(self, node: GeneratorExp) -> str: ...
    def postGt(self, node: Gt) -> str: ...
    def postIfExp(self, node: IfExp) -> str: ...
    def postIn(self, node: In) -> str: ...
    def postJoinedStr(self, node: JoinedStr) -> str: ...
    def postList(self, node: List) -> str: ...
    def postLt(self, node: Lt) -> str: ...
    def postMult(self, node: BinOp) -> str: ...
    def postName(self, node: Name) -> str: ...
    def postNot(self, node: UnaryOp) -> str: ...
    def postNotEq(self, node: NotEq) -> str: ...
    def postOr(self, node: BoolOp) -> str: ...
    def postPow(self, node: BinOp) -> str: ...
    def postSlice(self, node: Slice) -> str: ...
    def postStarred(self, node: Starred) -> str: ...
    def postSub(self, node: BinOp) -> str: ...
    def postSubscript(self, node: Subscript) -> str: ...
    def postTuple(self, node: Tuple) -> str: ...
    def postUSub(self, node: UnaryOp) -> str: ...
    def postcomprehension(self, node: comprehension) -> str: ...
    def postkeyword(self, node: keyword) -> str: ...

class PreTranslator(ASTTranslator):
    globals: dict[str, object]
    locals: dict[str, object]
    special_functions: set[Callable]
    const_functions: set[ConstType]
    contexts: list[Iterable[str]]
    externals: set[AST]

    def __init__(
        self,
        tree: AST,
        globals: dict[str, object],
        locals: dict[str, object],
        special_functions: set[Callable],
        const_functions: set[ConstType],
        outer_names: Sequence[str] = (),
    ) -> None: ...
    def dispatch(self, node: expr) -> None: ...
    def postCall(self, node: Call) -> None: ...
    def postCompare(self, node: Compare) -> None: ...
    def postConstant(self, node: Constant) -> None: ...
    def postDict(self, node: Dict) -> None: ...
    def postList(self, node: List) -> None: ...
    def postName(self, node: Name) -> None: ...
    def postSlice(self, node: Slice) -> None: ...
    def postStarred(self, node: Starred) -> None: ...
    def post_binop(self, node: BinOp) -> None: ...
    def postkeyword(self, node: keyword) -> None: ...
    def preGeneratorExp(self, node: GeneratorExp) -> bool: ...
    def preLambda(self, node: Lambda) -> bool: ...
