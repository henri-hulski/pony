from ast import (
    Assign,
    Attribute,
    BinOp,
    BoolOp,
    Bytes,
    Call,
    Compare,
    Constant,
    Dict,
    FormattedValue,
    GeneratorExp,
    IfExp,
    JoinedStr,
    List,
    Name,
    NameConstant,
    Num,
    Slice,
    Str,
    Subscript,
    Tuple,
    UnaryOp,
    cmpop,
    comprehension,
    expr,
    keyword,
    operator,
)
from collections import defaultdict
from collections.abc import Callable, Generator, Iterable
from types import CellType, CodeType
from typing import TypeAlias, overload

from typing_extensions import LiteralString

_ConstValue: TypeAlias = str | bytes | bool | int | float | complex | None

operator_mapping: dict[LiteralString, type[cmpop]]
ast_cache: dict[int, tuple[expr, set[str]]]

def binop(node_type: type[operator]) -> Callable: ...
@overload
def clean_assign(node: Name) -> Name: ...
@overload
def clean_assign(node: Assign) -> list[expr]: ...
def decompile(
    x: CodeType | Generator | Callable,
) -> tuple[expr, set[str], dict[str, CellType]]: ...
def is_const(
    value: _ConstValue | tuple[_ConstValue, ...] | tuple[tuple, ...],
) -> bool: ...
def make_const(
    value: _ConstValue | tuple[_ConstValue, ...] | tuple[tuple, ...],
) -> Constant: ...
def simplify(clause: expr) -> expr: ...

class DecompileError(NotImplementedError): ...

class Decompiler:
    abs_jump_to_top: int
    ast: expr
    assnames: set[str]
    code: CodeType
    conditions_end: int
    end: int
    external_names: set[str]
    for_iter_pos: int
    instructions: list[tuple[int, int, str, list[int]]]
    instructions_map: dict[int, int]
    jump_map: defaultdict[int, list[int]]
    kw_names: Iterable[str] | None
    names: set[str]
    next_pos: int
    or_jumps: set[int]
    pos: int
    stack: list[expr]
    start: int
    targets: dict[int, expr]

    def __init__(
        self, code: CodeType, start: int = 0, end: int | None = None
    ) -> None: ...
    def _call_function(
        self,
        args: Iterable[expr],
        keywords: Iterable[keyword] | None = None,
    ) -> GeneratorExp | Call: ...
    def analyze_jumps(self) -> None: ...
    def conditional_jump(self, endpos: int, if_true: bool) -> BoolOp: ...
    def conditional_jump_old(self, endpos: int, if_true: bool) -> BoolOp: ...
    def conditional_jump_new(self, endpos: int, if_true: bool) -> BoolOp: ...
    def conditional_jump_none_impl(self, endpos: int, negate: bool) -> BoolOp: ...
    def decompile(self) -> None: ...
    def get_instructions(self) -> None: ...
    def jump_if_none(self, endpos: int) -> BoolOp: ...
    def jump_if_not_none(self, endpos: int) -> BoolOp: ...
    def pop_items(self, size: int) -> list[expr]: ...
    def process_target(self, pos: int | None, partial: bool = False) -> None: ...
    def store(self, node: Name | Assign) -> None: ...
    def BINARY_OP(self, opcode: int) -> BinOp | Name: ...
    def BINARY_SUBSCR(self) -> Subscript: ...
    def BUILD_CONST_KEY_MAP(self, length: int) -> Dict: ...
    def BUILD_LIST(self, size: int) -> List: ...
    def BUILD_MAP(self, length: int) -> Dict: ...
    def BUILD_SLICE(self, size: int) -> Slice: ...
    def BUILD_STRING(self, count: int) -> JoinedStr: ...
    def BUILD_TUPLE(self, size: int) -> Tuple: ...
    def CACHE(self) -> None: ...
    def CALL(self, argc: int) -> Call | GeneratorExp: ...
    def CALL_FUNCTION_EX(self, argc: int) -> Call | GeneratorExp: ...
    def COMPARE_OP(self, op: str) -> Compare: ...
    def CONTAINS_OP(self, invert: int) -> Compare: ...
    def COPY_FREE_VARS(self, n: int) -> None: ...
    def FORMAT_VALUE(self, flags: int) -> FormattedValue: ...
    def FOR_ITER(self, endpos: int) -> comprehension: ...
    def GET_ITER(self) -> None: ...
    def IS_OP(self, invert: int) -> Compare: ...
    def JUMP_FORWARD(self, endpos: int) -> IfExp: ...
    def JUMP_IF_FALSE(self, endpos: int) -> BoolOp: ...
    def JUMP_IF_TRUE(self, endpos: int) -> BoolOp: ...
    def KW_NAMES(self, kw_names: Iterable[str]) -> None: ...
    def LIST_APPEND(self, offset: int): ...
    def LIST_EXTEND(self, offset: int) -> List: ...
    def LOAD_ATTR(self, attr_name: str, push_null: bool) -> Attribute: ...
    def LOAD_CLOSURE(self, freevar: str) -> Name: ...
    def LOAD_CONST(
        self,
        const_value: _ConstValue | tuple[_ConstValue, ...] | tuple[tuple, ...],
    ) -> Constant | Num | Str | Bytes | Tuple | NameConstant: ...
    def LOAD_DEREF(self, freevar: str) -> Name: ...
    def LOAD_FAST(self, varname: str) -> Name: ...
    def LOAD_GLOBAL(self, varname: str, push_null: int) -> Name: ...
    def LOAD_METHOD(self, methname: str) -> Attribute: ...
    def MAKE_CELL(self, freevar: str) -> None: ...
    def MAKE_FUNCTION(self, argc: int) -> expr: ...
    def POP_JUMP_IF_NONE(self, endpos: int) -> BoolOp: ...
    def POP_JUMP_IF_NOT_NONE(self, endpos: int) -> BoolOp: ...
    def POP_TOP(self) -> None: ...
    def PRECALL(self, argc: int) -> None: ...
    def PUSH_NULL(self) -> None: ...
    def RESUME(self, where: int) -> None: ...
    def RETURN_GENERATOR(self) -> None: ...
    def RETURN_VALUE(self) -> expr: ...
    def STORE_DEREF(self, freevar: str) -> None: ...
    def STORE_FAST(self, varname: str) -> None: ...
    def UNARY_NEGATIVE(self) -> UnaryOp: ...
    def UNARY_NOT(self) -> UnaryOp: ...
    def UNPACK_SEQUENCE(self, count: int) -> Assign: ...
    def YIELD_VALUE(self, _: None = None) -> GeneratorExp: ...

test_lines: str

def test(test_line: int | None = None) -> None: ...

class InvalidQuery(Exception): ...
