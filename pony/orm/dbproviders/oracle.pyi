json_item_re: Pattern[str]
NoneType: type[None]
provider_cls: type[OraProvider]
trigger_template: LiteralString

def get_inputsize(arg) -> cx_Oracle.DATETIME | None: ...
def output_type_handler(cursor, name, defaultType, size, precision, scale): ...
def set_input_sizes(cursor, arguments) -> None: ...
def to_int_or_decimal(val): ...
def to_decimal(val): ...

class OraBlobConverter(BlobConverter):
    def sql2py(self, val): ...

class OraBoolConverter(BoolConverter):
    def py2sql(self, val): ...
    def sql2py(self, val): ...
    def sql_type(self) -> str: ...

class OraBuilder(SQLBuilder):
    dialect: ClassVar[str]
    json_value_type_mapping: dict[type, str]

    def build_json_path(
        self, path: list[list[(str | int | ParamKey | Converter)]]
    ) -> tuple[Param | Value, bool, bool]: ...
    def DATE(self, expr: Sequence[str | list[str]]) -> tuple[str, Any, str]: ...
    def DATE_ADD(
        self,
        expr: list[str],
        delta: list[(str | timedelta | ParamKey | OraTimedeltaConverter)],
    ) -> tuple[str, Any, str, Any, str]: ...
    def DATE_DIFF(self, expr1, expr2) -> tuple[str, Any, str, Any, str]: ...
    def DATE_SUB(self, expr, delta) -> tuple[str, Any, str, Any, str]: ...
    def DATETIME_ADD(self, expr, delta) -> tuple[str, Any, str, Any, str]: ...
    def DATETIME_DIFF(self, expr1, expr2) -> tuple[str, Any, str, Any, str]: ...
    def DATETIME_SUB(self, expr, delta) -> tuple[str, Any, str, Any, str]: ...
    def GROUP_CONCAT(self, distinct, expr, sep=...): ...
    def INSERT(
        self,
        table_name: str,
        columns: Iterable[str | Iterable],
        values: Iterable[Sequence[str | tuple[int, None, None] | Converter]],
        returning: str | None = None,
    ) -> Sequence[str | list[str]]: ...
    def JSON_ARRAY_LENGTH(self, value): ...
    def JSON_CONTAINS(self, expr, path, key): ...
    def JSON_NONZERO(self, expr): ...
    def JSON_QUERY(self, expr, path): ...
    def JSON_VALUE(self, expr, path, type): ...
    def LIMIT(self, limit, offset=...): ...
    def MOD(self, a, b): ...
    def RANDOM(self): ...
    def ROWID(self, *expr_list): ...
    def SELECT(
        self, *sections: Sequence[str | list[str]]
    ) -> Sequence[str | Sequence[str | list[str]]]: ...
    def SELECT_FOR_UPDATE(
        self, nowait: bool, skip_locked: bool, *sections: Sequence[str | list[str]]
    ) -> tuple[Sequence[str | Sequence[str | list[str]]], str, str, str, str]: ...
    def TO_REAL(self, expr): ...
    def TO_STR(self, expr): ...

class OraColumn(Column):
    auto_template: ClassVar[str | None]

class OraConstMonad(ConstMonad):
    @staticmethod
    def new(value): ...

class OraDateConverter(DateConverter):
    def sql2py(self, val): ...

class OraDatetimeConverter(DatetimeConverter):
    sql_type_name: LiteralString

class OraDecimalConverter(DecimalConverter):
    def sql_type(self) -> str: ...

class OraIntConverter(IntConverter):
    signed_types: dict[int | None, str]
    unsigned_types: dict[int | None, str] | None

    def init(self, kwargs): ...

class OraJsonConverter(JsonConverter):
    json_kwargs: ClassVar[dict[str, Any]]
    optimistic: ClassVar[bool]

    def sql2py(self, dbval): ...
    def sql_type(self) -> str: ...

class OraNoneMonad(NoneMonad):
    def __init__(self, value=...) -> None: ...

class OraPool(Pool):
    cx_pool: cx_Oracle.SessionPool
    forked_pools: list[tuple[cx_Oracle.SessionPool, int]]
    kwargs: dict[str, Any]
    pid: int

    def __init__(self, **kwargs) -> None: ...
    def connect(self): ...
    def disconnect(self): ...
    def drop(self, con): ...
    def release(self, con): ...

class OraProvider(DBAPIProvider):
    converter_classes: list[
        tuple[PyType | type[None] | tuple[type[int]], type[Converter]]  # noqa: Y090
    ]
    dbapi_module: ModuleType
    dbschema_cls: type[DBSchema]
    dialect: str
    index_if_not_exists_syntax: bool
    max_name_len: int
    name_before_table: str
    paramstyle: str
    sqlbuilder_cls: type[OraBuilder]
    table_if_not_exists_syntax: bool
    translator_cls: type[OraTranslator]
    uint64_support: bool
    varchar_default_max_len: int | None

    def drop_table(self, connection, table_name): ...
    @wrap_dbapi_exceptions
    def execute(self, cursor, sql, arguments=..., returning_id=...): ...
    def fk_exists(self, connection, table_name, fk_name, case_sensitive=...): ...
    def get_pool(self, *args, **kwargs): ...
    def index_exists(self, connection, table_name, index_name, case_sensitive=...): ...
    @wrap_dbapi_exceptions
    def inspect_connection(self, connection): ...
    def normalize_name(self, name): ...
    def normalize_vars(self, vars, vartypes): ...
    @wrap_dbapi_exceptions
    def set_transaction_mode(self, connection, cache): ...
    def should_reconnect(self, exc): ...
    def table_exists(self, connection, table_name, case_sensitive=...): ...
    def table_has_data(self, connection, table_name): ...

class OraRealConverter(RealConverter):
    def sql_type(self) -> str: ...

class OraSchema(DBSchema):
    column_class: ClassVar[type[Column]]
    dialect: ClassVar[str]
    table_class: ClassVar[type[Table]]

class OraSequence(DBObject):
    name: TableName
    table: OraTable
    typename: ClassVar[str]

    def __init__(self, table: OraTable, name: TableName | None = None) -> None: ...
    def exists(
        self,
        provider: OraProvider,
        connection: DbConnection,
        case_sensitive: bool = True,
    ): ...
    def get_create_command(self): ...

class OraStrConverter(StrConverter):
    def sql2py(self, val): ...
    def sql_type(self) -> str: ...
    def validate(self, val, obj=...): ...

class OraTable(Table):
    def get_objects_to_create(self, created_tables=...): ...

class OraTimedeltaConverter(TimedeltaConverter):
    sql_type_name: LiteralString

    def __init__(self, provider, py_type, attr=...) -> None: ...

class OraTimeConverter(TimeConverter):
    sql_type_name: LiteralString

    def __init__(self, provider, py_type, attr=...) -> None: ...
    def py2sql(self, val): ...
    def sql2py(self, val): ...

class OraTranslator(SQLTranslator):
    ConstMonad: type[OraConstMonad]
    NoneMonad: type[OraNoneMonad]
    dialect: ClassVar[str]
    json_path_wildcard_syntax: ClassVar[bool]
    json_values_are_comparable: ClassVar[bool]
    rowid_support: ClassVar[bool]

class OraTrigger(DBObject):
    typename: ClassVar[str]

    def __init__(self, table, column, sequence) -> None: ...
    def exists(self, provider, connection, case_sensitive=...): ...
    def get_create_command(self): ...

class OraUuidConverter(UuidConverter):
    def sql_type(self) -> str: ...
